# Flight Eye VPS settings (FLIGHT-EYE-PLAN.md, Phase 3). Copy to
# /etc/flight-eye.env, owned root:flight-eye with mode 0640, for the systemd
# unit's EnvironmentFile. Names and placeholders only; .env.example at the
# repository root documents every setting in full.

# The public host the phone app loads, exactly as written in the Caddyfile.
# Caddy passes the browser's Host header through unchanged, and the server
# answers only localhost, IP addresses and the names listed here.
GEV_ALLOWED_HOSTS=flight-eye.example.com

# Caddy connects from loopback: believe its forwarding headers
# (X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Host) from these exact
# socket addresses and no others. Without this the voice and HUD routes
# answer 403 behind TLS and every phone shares one rate-limit bucket.
GEV_TRUSTED_PROXY=127.0.0.1,::1,::ffff:127.0.0.1

# Abuse brake for the OpenAI-billed routes (/api/realtime/token and
# /api/openai/hud-summary): a request must carry this value as
# X-FlightEye-App-Key, which the phone shell injects into the page. Generate
# one with `openssl rand -hex 32`. Rotate by changing it here and in the shell.
GEV_APP_KEY=

# Spend brake: successful voice token mints per UTC day, shared by every phone
# with the app key (per client address while GEV_APP_KEY is unset). Kept in
# memory, so a restart forgets the count; set a usage limit in the OpenAI
# dashboard as well.
GEV_VOICE_DAILY_MINTS=40

# Aircraft data from adsb.lol only (ODbL, no key, 250 nm around the view).
# Never contacts OpenSky, whose licence is non-commercial.
FLIGHTS_PROVIDER=adsb-lol

# Voice and HUD summaries. SERVER-SIDE ONLY. Leave empty to run without voice.
OPENAI_API_KEY=

# Bind to loopback: Caddy is the only client. The unit already sets these;
# uncomment to change them (the Caddyfile's reverse_proxy must match).
# HOST=127.0.0.1
# PORT=4173
