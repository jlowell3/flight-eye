# Flight Eye on cPanel shared hosting (deploy/CPANEL.md). Copy to
# ~/flight-eye/.env on the host; the server loads it at start. Names and
# placeholders only; .env.example at the repository root documents every
# setting in full.

# The subdomain the phone app loads, exactly as created in cPanel.
GEV_ALLOWED_HOSTS=gev.sg1.space

# Requests arrive only through the host's own proxy (Passenger), over a socket
# with no peer address: trust every connection's forwarding headers, and take
# https as the scheme when the proxy does not say.
GEV_TRUSTED_PROXY=any
GEV_PROXY_SCHEME=https

# Abuse brake for the OpenAI-billed routes: the phone shell injects this value,
# the page sends it as X-FlightEye-App-Key. Generate one with
# `openssl rand -hex 32` (or any long random string). Rotate here and in the
# shell build.
GEV_APP_KEY=

# Spend brake: successful voice token mints per UTC day, shared by every phone
# with the app key. In memory; Passenger restarts forget it. Set a usage limit
# in the OpenAI dashboard as well.
GEV_VOICE_DAILY_MINTS=40

# Which feed answers the Live Flights layer:
#   adsb-lol  aircraft within 250 nm of the view only (adsb.lol, then adsb.fi;
#             ODbL, no key). Empty at a world zoom over the ocean.
#   opensky   the worldwide OpenSky snapshot, like a flight-radar site
#             (non-commercial licence; a free OpenSky account raises the
#             daily credit budget from about 400 to about 4000).
FLIGHTS_PROVIDER=opensky
# OpenSky auth: anon needs no account; oauth uses the client credentials
# from the OpenSky account dashboard.
OPENSKY_AUTH_MODE=anon
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Voice and HUD summaries. Leave empty to run without voice.
OPENAI_API_KEY=
